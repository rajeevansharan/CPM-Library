// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Scripture School Books ────────────────────────────────────────────────────
model ScriptureBook {
  id          String   @id @default(cuid())
  title       String
  grade       String
  description String?
  imageUri    String?
  fileUrl     String?
  category    String   @default("Grade")
  type        String   @default("scripture")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("scripture_books")
}

// ─── Voice of Pentecost Issues ─────────────────────────────────────────────────
model VoiceBook {
  id          String   @id @default(cuid())
  title       String
  month       String
  year        String
  subtitle    String?
  description String?
  imageUri    String?
  fileUrl     String?
  category    String   @default("Topic")
  type        String   @default("voice")
  isNew       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("voice_books")
}

// ─── Books of Pentecost ────────────────────────────────────────────────────────
model PentecostBook {
  id          String   @id @default(cuid())
  title       String
  author      String?
  description String?
  category    String   @default("General")
  languages   String[] @default([])
  imageUri    String?
  fileUrl     String?
  type        String   @default("pentecost")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pentecost_books")
}

// ─── Users ──────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("USER") // "USER" or "ADMIN"
  name      String?
  memberId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
